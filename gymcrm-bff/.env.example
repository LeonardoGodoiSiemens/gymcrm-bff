# Porta HTTP do BFF
PORT=3000

# URLs dos serviços a jusante (use as URLs PÚBLICAS da nuvem no deploy)
PRODUCTS_URL=http://localhost:3001
ENROLLMENTS_URL=http://localhost:3002
# URL completa do HTTP Trigger da Azure Function + function key
FUNCTION_URL=https://<function-app>.azurewebsites.net/api/enrich
FUNCTION_KEY=

# Timeout (ms) de cada chamada a jusante
REQUEST_TIMEOUT_MS=8000

# Origem(ns) permitida(s) no CORS, separadas por vírgula. "*" libera todas.
CORS_ORIGIN=*

# (Opcional) Segredo injetado pelo API Gateway no header x-gateway-secret.
# Se definido, o BFF só aceita requisições que passaram pelo gateway (exceto /health e /swagger).
GATEWAY_SECRET=
